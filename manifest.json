{
  "manifest_version": 3,
  "name": "YouTube Dual Subtitles & Quick Translate",
  "version": "1.0",
  "description": "高效能 YouTube 雙語字幕、滑動窗口動態翻譯與反白查詞擴充功能",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://translate.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "字幕翻譯設定"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
