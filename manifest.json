{
  "manifest_version": 3,
  "name": "YouTube Dual Subtitles & Quick Translate",
  "version": "1.1.0",
  "description": "支援傳統CC與Gemini即時串流雙軌分流、句級雙槽雙語字幕、60fps零延遲同步與反白查詞原聲重播",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://translate.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "字幕翻譯設定",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
